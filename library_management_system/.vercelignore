cat > .vercelignore <<'EOF'
# Python
.venv/
venv/
__pycache__/
*.pyc

# Local database
db.sqlite3
*.sqlite3

# User uploaded files - NEVER deploy these
media/**
media/

# Generated static collection
staticfiles/**
staticfiles/

# Environment/secrets
.env
.env.*
.env.local
.env.vercel

# Vercel/Git metadata
.vercel/
.git/
.gitignore
EOF
